# ─────────────────────────────────────────────────────────────────────────────
# ifthenpay Moodle plugin — local development configuration.
#
# Copy to `.env` (the dev container does this for you on first create) and edit.
# Every value below has a working default in docker-compose.yml, so the stack
# also boots with no .env at all.
#
# Changes to this file take effect on `docker compose up -d` (no rebuild),
# EXCEPT the ones marked "rebuild" which are Docker build arguments.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host user (Linux only) ───────────────────────────────────────── rebuild ──
# Files in ./src are shared between your editor, the dev container and Apache.
# Set these to `id -u` / `id -g` if your host user is not 1000:1000, so that
# everything writes as you. On macOS/Windows leave the defaults.
APP_UID=1000
APP_GID=1000

# ── Moodle version ───────────────────────────────────────────────── rebuild ──
# Pinned release, verified against the published SHA-256 checksum.
# Bump these and rebuild to test another Moodle; the core files and the
# database are upgraded automatically on the next container start.
# Available versions: https://packaging.moodle.org/
MOODLE_BRANCH=stable501
MOODLE_VERSION=5.1.5

# ── Site ─────────────────────────────────────────────────────────────────────
MOODLE_PORT=8080
PMA_PORT=8081
# Public base URL of the site. The container rewrites config.php and purges
# caches on start when this changes.
MOODLE_WWWROOT=http://localhost:8080
MOODLE_SITE_FULLNAME=ifthenpay Dev Academy
MOODLE_SITE_SHORTNAME=ifthenpay
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=adminpass
MOODLE_ADMIN_EMAIL=admin@ifthenpay.local
MOODLE_LANG=en

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=moodle
DB_USER=moodleuser
DB_PASS=userpass
DB_ROOT_PASS=rootpass

# ── Developer conveniences ───────────────────────────────────────────────────
# 1 = DEVELOPER debug level, no JS/template/lang caching, mail disabled,
#     password policy off. Set to 0 for a production-like site.
MOODLE_DEV_MODE=1
# 1 = run admin/cli/upgrade.php on every start, so plugin version bumps and
#     Moodle upgrades install themselves.
MOODLE_AUTO_UPGRADE=1
# 1 = enable the ifthenpay gateway on every start, so the dev site is usable
#     immediately. Set to 0 if you want to control the enabled state, and
#     the Backoffice Key, yourself in Site administration.
PLUGIN_AUTO_ENABLE=1

# ── Xdebug ───────────────────────────────────────────────────────────────────
# App container (web requests). `off` for maximum speed.
XDEBUG_MODE=debug,develop
# trigger = only debug requests carrying XDEBUG_TRIGGER (browser extension,
#           ?XDEBUG_TRIGGER=1, or a cookie). yes = break on every request.
XDEBUG_START=trigger
# Dev container (CLI: composer, phpcs, phpstan, phpunit). Keep `off`; run a
# single command with debugging via: XDEBUG_MODE=debug XDEBUG_TRIGGER=1 php ...
DEV_XDEBUG_MODE=off
XDEBUG_VERSION=3.4.0
