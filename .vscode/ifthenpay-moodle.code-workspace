{
  // Optional multi-root view: the plugin repository plus Moodle core, for
  // browsing and debugging into core. The dev container opens
  // /workspace/plugin on its own; open this file only when you want core in
  // the explorer as well (File → Open Workspace from File…).
  "folders": [
    { "name": "Plugin (repo)", "path": "/workspace/plugin" },
    { "name": "Moodle Core", "path": "/var/www/html" }
  ],
  "settings": {
    // Moodle core also contains the plugin (bind-mounted at
    // public/payment/gateway/ifthenpay); it must be indexed once only.
    "intelephense.files.exclude": [
      "/var/www/html/public/payment/gateway/ifthenpay/**",
      "/var/www/html/vendor/**",
      "/var/www/moodledata/**",
      "/var/www/phpunitdata/**",
      "**/.git/**",
      "**/node_modules/**",
      "**/amd/build/**",
      "**/vendor/**/{Tests,tests}/**"
    ],
    "intelephense.environment.phpVersion": "8.3",
    "intelephense.maxMemory": 4096,
    "intelephense.files.maxSize": 3000000,

    "files.exclude": {
      "**/.moodle-version": true
    },
    "files.watcherExclude": {
      "/var/www/html/**": true,
      "/var/www/moodledata/**": true,
      "**/node_modules/**": true,
      "**/vendor/**": true
    },
    "search.exclude": {
      "/var/www/html/vendor/**": true,
      "**/node_modules": true,
      "**/vendor": true,
      "**/src/amd/build": true
    },

    "terminal.integrated.splitCwd": "workspaceRoot",
    "terminal.integrated.cwd": "/workspace/plugin"
  }
}
