{
  "private": true,
  "devDependencies": {
    "@babel/eslint-plugin": "^7.29.7",
    "@eslint/js": "^9.17",
    "@stylistic/stylelint-plugin": "^3.1",
    "eslint": "^9.17",
    "eslint-plugin-jsdoc": "^50.6",
    "eslint-plugin-promise": "^7.2",
    "globals": "^15.14",
    "grunt": "^1.6",
    "grunt-cli": "^1.5",
    "grunt-contrib-uglify": "^5.2",
    "grunt-contrib-watch": "^1.1",
    "load-grunt-tasks": "^5.1",
    "stylelint": "^16.12",
    "stylelint-config-standard": "^36.0"
  },
  "scripts": {
    "lint:js": "eslint src/amd/src --ext .js",
    "lint:js:fix": "eslint src/amd/src --ext .js --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint": "npm run lint:js; s=$?; npm run lint:css; t=$?; [ \"$s\" -eq 0 ] && [ \"$t\" -eq 0 ]",
    "lint:fix": "npm run lint:js:fix; s=$?; npm run lint:css:fix; t=$?; [ \"$s\" -eq 0 ] && [ \"$t\" -eq 0 ]",
    "build": "grunt build-amd",
    "watch": "grunt watch-amd"
  }
}
