# Shared by phpstan.neon (the full, level max check) and phpstan-compat.neon (the check against
# the oldest supported Moodle). Paths are relative to this file.
includes:
  - vendor/micaherne/phpstan-moodle/extension.neon

parameters:
  moodle:
    rootDirectory: /var/www/html

  paths:
    - src

  bootstrapFiles:
    - vendor/autoload.php

  # Language packs are excluded from analysis. They are declarative data — a bare
  # `$string['key'] = '...';` sequence with no declaration — so PHPStan has nothing useful to say
  # about them at level max beyond one error per string (about 400 across four packs), which would
  # otherwise need a blanket ignoreErrors rule. Excluding them costs no coverage: every file with
  # logic in it is still analysed.
  excludePaths:
    analyseAndScan:
      - src/lang/*/paygw_ifthenpay.php

  # Errors that appeared only in local runs ("return statement is missing" on methods that visibly
  # return, baseline entries suddenly unmatched) came from the dev container mounting the plugin
  # inside the Moodle tree as well, so every class existed under two paths. Analyse locally with
  # `mdl analyse` (phpstan.local.neon), which uses a core view without the plugin, as CI does.

  # One entry from ifthenpay's method catalog (/gateway/methods/available), as
  # data_formatter::format_available_payment_methods() returns it. Aliased because the shape is
  # threaded through lib.php and the gateway form, and spelling it out at each hop is unreadable.
  typeAliases:
    MethodMeta: 'array{position: int, image: string, tooltip: string, label: string}'

  inferPrivatePropertyTypeFromConstructor: true
  treatPhpDocTypesAsCertain: false
