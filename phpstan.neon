includes:
  - vendor/micaherne/phpstan-moodle/extension.neon
  - phpstan-baseline.neon

parameters:
  moodle:
    rootDirectory: /var/www/html

  level: max

  paths:
    - src

  bootstrapFiles:
    - vendor/autoload.php

  # Language packs are excluded from analysis. They are declarative data — a bare
  # `$string['key'] = '...';` sequence with no declaration — so PHPStan has nothing useful to say
  # about them, and used to need a blanket ignoreErrors rule to swallow one error per string
  # (400 of them across four packs). Worse, their presence in the file set changed the analysis of
  # unrelated class files: adding the es and fr packs turned api_client.php from clean into six
  # non-ignorable, provably false "return statement is missing" errors on methods that visibly
  # return. Excluding them removes the trigger and the 400-error special case, and costs no
  # coverage — every file with logic in it is still analysed.
  excludePaths:
    analyseAndScan:
      - src/lang/*/paygw_ifthenpay.php

  # A related phantom-error family, same extension: a plugin class file that references another
  # class under paygw_ifthenpay\local\ directly draws non-ignorable "return statement is missing"
  # errors. Verified case by case: config_form -> data_formatter and adminsetting\backofficekey ->
  # api_client both trigger it, so those two calls go through the global functions in lib.php
  # instead. Referencing config_form itself does not, so gateway.php calls it directly.

  # One entry from ifthenpay's method catalog (/gateway/methods/available), as
  # data_formatter::format_available_payment_methods() returns it. Aliased because the shape is
  # threaded through lib.php and the gateway form, and spelling it out at each hop is unreadable.
  typeAliases:
    MethodMeta: 'array{position: int, image: string, tooltip: string, label: string}'

  tmpDir: ./.phpstan-cache
  inferPrivatePropertyTypeFromConstructor: true
  treatPhpDocTypesAsCertain: false
