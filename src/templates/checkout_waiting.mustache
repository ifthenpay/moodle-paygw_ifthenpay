{{!
    @template paygw_ifthenpay/checkout_waiting
    Classes required for JS:
    * none
    Data attributes required for JS:
    * data-region="ifthenpay-reopen" (the container shown once the checkout URL is known)
    * data-action="paygw_ifthenpay/reopen" (the button inside it)

    Shown on the Moodle page while the ifthenpay checkout runs in another tab: what to do, and a way
    back to the checkout for anyone who closed it or had it blocked.

    Context variables required for this template:
    * message - Instruction shown under the spinner.
    * reopenlabel - Label of the button that opens the checkout again.
    Example context (json):
    {"message": "Complete your payment in the ifthenpay tab.", "reopenlabel": "Open the checkout again"}

}}
<div class="text-center p-4" role="status" aria-live="polite">
    <div class="spinner-border text-primary mb-3" aria-hidden="true"></div>
    <p class="mb-3">{{message}}</p>
    <div class="d-none" data-region="ifthenpay-reopen">
        <button type="button" class="btn btn-secondary" data-action="paygw_ifthenpay/reopen">{{reopenlabel}}</button>
    </div>
</div>
